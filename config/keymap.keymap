#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    macros {
        sh: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none      &none     &none     &none     &none                                                          &none        &none  &none  &none  &none                 &none
&none  &kp Q      &kp W     &kp D     &kp R     &kp V                                                          &sh          &kp Y  &kp K  &kp P  &kp P                 &none
&none  &kp A      &kp S     &kp E     &kp T     &kp G        &none                      &none                  &kp H        &kp U  &kp I  &kp O  &kp SEMI              &none
&none  &kp Z      &kp X     &kp C     &kp B     &kp F        &kp SPACE                  &kp RET                &kp J        &kp N  &kp M  &kp L  &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &kp BSPC  &lt 2 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &mt RSHIFT LANGUAGE_2  &lt 3 ENTER  &none  &none  &none  &kp RET               &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans        &trans        &trans                      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans        &trans                      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK     &mkp LCLK     &trans      &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans        &trans      &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans     &trans          &trans           &trans                           &trans             &trans        &trans        &trans        &trans         &trans
&trans  &kp LS(PAGE_UP)  &kp HOME   &kp UP_ARROW    &kp END          &mkp MB5                         &kp LS(SEMICOLON)  &kp N7        &kp N8        &kp N9        &kp LS(SLASH)  &trans
&trans  &kp PAGE_DOWN    &kp LEFT   &kp DOWN_ARROW  &kp RIGHT_ARROW  &mkp MB4         &trans  &trans  &kp LS(APOS)       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS      &trans
&trans  &kp LC(Z)        &kp LC(X)  &kp LC(C)       &kp LC(V)        &kp PRINTSCREEN  &trans  &trans  &kp BACKSPACE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT        &trans
&trans  &trans           &trans     &trans          &trans           &trans           &trans  &trans  &kp N0             &trans        &trans        &trans        &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                  &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1  &kp F2  &kp F7   &kp F8   &none                   &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F3  &kp F4  &kp F9   &kp F10  &none   &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F5  &kp F6  &kp F11  &kp F12  &none   &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };
    };
};
