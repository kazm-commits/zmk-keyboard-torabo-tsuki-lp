#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <0>;
    flavor = "balanced";
};

/* ================================================= */
/* トラックボールのレイヤー別挙動オーバーライド        */
/* ZMK公式機能: Layer Specific Overrides を適用      */
/* ================================================= */
&pointing_listener {
    /* [Layer 1] 細かく動く（精密ポインタ移動） */
    precision_layer {
        layers = <1>;
        /* 移動量を 1/3 に減衰 */
        input-processors = <&zip_xy_scaler 1 3>;
    };

    /* [Layer 2] スクロール（標準速度） */
    scroll_layer {
        layers = <2>;
        input-processors = 
            <&zip_xy_scaler 1 16>,
            <&zip_xy_to_scroll_mapper>;
    };

    /* [Layer 3] 細かいスクロール（精密スクロール） */
    fine_scroll_layer {
        layers = <3>;
        input-processors = 
            <&zip_xy_scaler 1 48>,
            <&zip_xy_to_scroll_mapper>;
    };
};
/* ================================================= */

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        ZenHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <13 14>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <14 15>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <26 27>;
        };

        back_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <41 40>;
        };

        return {
            bindings = <&kp RETURN>;
            key-positions = <15 16>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <27 28>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <41 42>;
        };

        Lkakko {
            bindings = <&kp LS(N8)>;
            key-positions = <28 26>;
        };

        Lkagikakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <25 28>;
        };

        dublequort {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <21 20>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <35 34>;
        };

        quort {
            bindings = <&kp LS(N7)>;
            key-positions = <49 48>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <19 20>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <33 34>;
        };

        apos {
            bindings = <&kp APOS>;
            key-positions = <47 48>;
        };

        Rkakko {
            bindings = <&kp LS(N9)>;
            key-positions = <33 35>;
        };

        Rkagikakko {
            bindings = <&kp BACKSLASH>;
            key-positions = <33 36>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <47 33>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <48 34>;
        };
    };

    macros {
        sh: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            /* 論理的弱点の修正: ZMKの仕様に基づき、複数のキー操作はカンマ区切り、またはmacro_tapを使用 */
            bindings = <&macro_tap &kp S &kp H>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO_LAYER_0";
            bindings = <&mo>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt2: lt2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        mt2: mt2 {
            compatible = "zmk,behavior-hold-tap";
            label = "MT2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none  &none            &none              &none              &none                  &none                                                       &none                      &none                 &none               &none             &none                    &none
&none  &kp Q  &kp W            &mt2 LEFT_GUI D    &kp R              &kp V                                                                              &sh                        &kp Y                 &mt2 RIGHT_GUI K    &kp P             &mt2 LEFT_BRACKET SLASH  &none
&none  &kp A  &mt2 LEFT_ALT S  &mt2 LEFT_SHIFT E  &mt2 LEFT_CONTROL T    &kp G        &none                      &none         &kp H                      &mt2 RIGHT_CONTROL U  &mt2 RIGHT_SHIFT I  &mt2 RIGHT_ALT O  &mt2 EQUAL MINUS         &none
&none  &kp Z  &kp X            &kp C              &kp B              &kp F        &kp SPACE                  &kp SPACE     &kp J                      &kp N                 &kp M               &kp L             &lt2 1 INTERNATIONAL_1   &none
&none  &none  &none            &none              &lt 3 INTERNATIONAL_5  &lt 2 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &lt 3 RETURN  &mt RIGHT_SHIFT BACKSPACE  &none                      &none                 &none               &kp RET                  &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans        &trans        &trans                                      &trans  &trans     &trans                  &trans                   &trans     &trans
&trans  &trans  &trans  &trans        &trans        &trans                                      &trans  &kp LC(Y)  &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT_ARROW))  &kp LC(P)  &trans
&trans  &trans  &trans  &mkp RCLK     &mkp LCLK     &trans      &trans  &trans  &trans  &kp LC(A)  &mkp LCLK               &mkp RCLK                &kp LC(F)  &trans
&trans  &trans  &trans  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &trans  &kp LC(Z)  &kp LC(X)               &kp LC(C)                &kp LC(V)  &trans
&trans  &trans  &trans  &trans        &trans        &trans      &trans  &trans  &trans  &trans     &trans                  &trans                   &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans     &trans          &trans          &trans                                           &trans         &trans  &trans        &trans        &trans        &trans
&trans  &kp LS(PAGE_UP)  &kp HOME   &kp UP_ARROW    &kp END         &mkp MB5                                         &kp KP_PLUS    &kp N7  &kp N8        &kp N9        &kp KP_SLASH  &trans
&trans  &kp PAGE_DOWN    &kp LEFT   &kp DOWN_ARROW  &kp RIGHT_ARROW &mkp MB4         &trans  &trans  &kp LS(APOS)   &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp KP_MINUS  &trans
&trans  &kp LC(Z)        &kp LC(X)  &kp LC(C)       &kp LC(V)       &kp PRINTSCREEN  &trans  &trans  &kp BACKSPACE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_DOT    &trans
&trans  &trans           &trans     &trans          &trans          &trans           &trans  &trans  &kp N0         &trans         &trans  &trans        &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                                &trans  &trans            &trans            &trans                 &trans  &trans
&trans  &kp F1  &kp F2  &kp F7   &kp F8   &none                                 &trans  &kp LS(NUMBER_1)  &kp LS(SLASH)     &kp INTERNATIONAL_3      &trans  &trans
&trans  &kp F3  &kp F4  &kp F9   &kp F10  &none   &trans  &trans  &trans  &kp LS(N3)        &kp LS(NUMBER_4)  &kp LS(INTERNATIONAL_3)  &trans  &trans
&trans  &kp F5  &kp F6  &kp F11  &kp F12  &none   &trans  &trans  &trans  &kp LS(N5)        &kp LS(NUMBER_6)  &kp EQUAL                &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans            &trans            &trans                   &trans  &trans
            >;
        };
    };
};
